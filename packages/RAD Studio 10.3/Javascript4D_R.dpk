package Javascript4D_R;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE RELEASE}
{$ENDIF IMPLICITBUILDING}
{$LIBSUFFIX AUTO}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl;

contains
  JS4D.Json in '..\..\Source\API\JS4D.Json.pas',
  JS4D.Engine in '..\..\Source\API\JS4D.Engine.pas',
  JS4D.Errors in '..\..\Source\Core\JS4D.Errors.pas',
  JS4D.RegExpSyntax in '..\..\Source\Core\JS4D.RegExpSyntax.pas',
  JS4D.RegExpTranslator in '..\..\Source\Core\JS4D.RegExpTranslator.pas',
  JS4D.PcreMatcher in '..\..\Source\Core\JS4D.PcreMatcher.pas',
  JS4D.Types in '..\..\Source\Core\JS4D.Types.pas',
  JS4D.Lexer in '..\..\Source\Lexer\JS4D.Lexer.pas',
  JS4D.SlashContext in '..\..\Source\Lexer\JS4D.SlashContext.pas',
  JS4D.Tokens in '..\..\Source\Lexer\JS4D.Tokens.pas',
  JS4D.AST in '..\..\Source\Parser\JS4D.AST.pas',
  JS4D.Parser in '..\..\Source\Parser\JS4D.Parser.pas',
  JS4D.ParserScope in '..\..\Source\Parser\JS4D.ParserScope.pas',
  JS4D.Builtins in '..\..\Source\Runtime\JS4D.Builtins.pas',
  JS4D.PatternOperations in '..\..\Source\Runtime\JS4D.PatternOperations.pas',
  JS4D.JsonReader in '..\..\Source\API\JS4D.JsonReader.pas',
  JS4D.JsonReviver in '..\..\Source\API\JS4D.JsonReviver.pas',
  JS4D.JsonSyntax in '..\..\Source\API\JS4D.JsonSyntax.pas',
  JS4D.NumberFormat in '..\..\Source\Core\JS4D.NumberFormat.pas',
  JS4D.NumberParse in '..\..\Source\Core\JS4D.NumberParse.pas',
  JS4D.UriCoding in '..\..\Source\Core\JS4D.UriCoding.pas',
  JS4D.SlotMap in '..\..\Source\Core\JS4D.SlotMap.pas',
  JS4D.SymbolRegistry in '..\..\Source\Core\JS4D.SymbolRegistry.pas',
  JS4D.Symbols in '..\..\Source\Core\JS4D.Symbols.pas',
  JS4D.ArgumentsObject in '..\..\Source\Runtime\JS4D.ArgumentsObject.pas',
  JS4D.ArrayGeneric in '..\..\Source\Runtime\JS4D.ArrayGeneric.pas',
  JS4D.ArrayIterator in '..\..\Source\Runtime\JS4D.ArrayIterator.pas',
  JS4D.ArrayStatics in '..\..\Source\Runtime\JS4D.ArrayStatics.pas',
  JS4D.ArrayIteration in '..\..\Source\Runtime\JS4D.ArrayIteration.pas',
  JS4D.ArrayLike in '..\..\Source\Runtime\JS4D.ArrayLike.pas',
  JS4D.BuiltinAttributes in '..\..\Source\Runtime\JS4D.BuiltinAttributes.pas',
  JS4D.DateBuiltins in '..\..\Source\Runtime\JS4D.DateBuiltins.pas',
  JS4D.DateMath in '..\..\Source\Runtime\JS4D.DateMath.pas',
  JS4D.DateParser in '..\..\Source\Runtime\JS4D.DateParser.pas',
  JS4D.DateText in '..\..\Source\Runtime\JS4D.DateText.pas',
  JS4D.GlobalScope in '..\..\Source\Runtime\JS4D.GlobalScope.pas',
  JS4D.LexicalStates in '..\..\Source\Runtime\JS4D.LexicalStates.pas',
  JS4D.MathFunctions in '..\..\Source\Runtime\JS4D.MathFunctions.pas',
  JS4D.NumericBuiltins in '..\..\Source\Runtime\JS4D.NumericBuiltins.pas',
  JS4D.ObjectKeys in '..\..\Source\Runtime\JS4D.ObjectKeys.pas',
  JS4D.ObjectScope in '..\..\Source\Runtime\JS4D.ObjectScope.pas',
  JS4D.SymbolBuiltins in '..\..\Source\Runtime\JS4D.SymbolBuiltins.pas',
  JS4D.Operators in '..\..\Source\Runtime\JS4D.Operators.pas',
  JS4D.UnicodeNormalization in '..\..\Source\Runtime\JS4D.UnicodeNormalization.pas',
  JS4D.PropertyDescriptors in '..\..\Source\Runtime\JS4D.PropertyDescriptors.pas',
  JS4D.PrototypeMethods in '..\..\Source\Runtime\JS4D.PrototypeMethods.pas',
  JS4D.Interpreter in '..\..\Source\Runtime\JS4D.Interpreter.pas';

end.
