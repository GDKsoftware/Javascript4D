        <DCCReference Include="..\..\Source\Runtime\JS4D.BuiltinAttributes.pas"/>
        <DCCReference Include="..\..\Source\Runtime\JS4D.DateBuiltins.pas"/>
        <DCCReference Include="..\..\Source\Runtime\JS4D.DateMath.pas"/>
        <DCCReference Include="..\..\Source\Runtime\JS4D.DateParser.pas"/>
        <DCCReference Include="..\..\Source\Runtime\JS4D.DateText.pas"/>
        <DCCReference Include="..\..\Source\Runtime\JS4D.GlobalScope.pas"/>
